# Generate a unique secret before running Docker Compose, for example with: openssl rand -hex 32
ORB_TOKEN=replace-with-a-random-secret

# Optional GitHub classic PAT for dashboard notifications. Leave empty to disable polling.
ORB_GITHUB_PAT=
ORB_GITHUB_POLL_SEC=60

# Dashboard is bound to localhost by Compose; this selects the host-side port.
ORB_DASHBOARD_PUBLISHED_PORT=7421
